# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- MongoDB Atlas -----------------------------------------------------------
# Leave empty to use the built-in in-memory database (data is lost on restart).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=itsm_helpdesk

# --- LLM: Hugging Face Inference API (free token) ----------------------------
# Create a token at https://huggingface.co/settings/tokens (type: Read).
# Without a token the app still works: answers are extracted verbatim from the KB.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# --- Embeddings -------------------------------------------------------------
# auto = sentence-transformers if it can load, otherwise TF-IDF fallback.
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- AI governance ----------------------------------------------------------
CONFIDENCE_THRESHOLD=0.6

# --- ServiceNow -------------------------------------------------------------
# mock = built-in mock ServiceNow API (default). real = your developer instance.
SERVICENOW_MODE=mock
SERVICENOW_INSTANCE=https://devXXXXX.service-now.com
SERVICENOW_USER=admin
SERVICENOW_PASSWORD=

# --- Demo ---------------------------------------------------------------------
PROVISION_SECONDS=8
